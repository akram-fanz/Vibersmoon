{
  "name": "vibersmoon",
  "version": "2.0.0",
  "description": "Vibersmoon - Telegram multi-purpose bot (grammY + SQLite + yt-dlp)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test tests/*.test.js",
    "update:ytdlp": "bash scripts/update-ytdlp.sh",
    "backup:db": "bash scripts/backup-db.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.65",
    "axios": "^1.7.2",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "fluent-ffmpeg": "^2.1.3",
    "grammy": "^1.30.0",
    "jsqr": "^1.4.0",
    "mathjs": "^13.1.1",
    "msedge-tts": "^1.3.4",
    "openai": "^4.70.0",
    "p-queue": "^9.3.3",
    "pdf-parse": "^1.1.1",
    "pino": "^9.4.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "tesseract.js": "^5.1.1",
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "tesseract.js@5.1.1": true,
    "better-sqlite3@13.0.3": true
  }
}