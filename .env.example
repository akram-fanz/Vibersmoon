# Contoh file .env (template) — isi nilai asli di .env, JANGAN di file ini!

# Wajib
BOT_TOKEN=
ADMIN_IDS=

# Chat AI (opsional) — endpoint kompatibel OpenAI, mis. Groq: https://api.groq.com/openai/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Vision AI (opsional) — model vision untuk analisis foto
AI_VISION_MODEL=gpt-4o-mini

# Cuaca (opsional) — API key gratis dari openweathermap.org
WEATHER_API_KEY=

# Downloader YouTube/Instagram (opsional)
YT_DL_API_URL=
IG_DL_API_URL=

# Rate limit & kuota (opsional, ada default)
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
DOWNLOAD_QUOTA=20
