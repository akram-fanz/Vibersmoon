# Contoh file .env (template) — isi nilai asli di .env, JANGAN di file ini!

# Wajib
BOT_TOKEN=your_bot_token_dari_botfather
ADMIN_IDS=123456789

# Chat AI (opsional) — endpoint kompatibel OpenAI, mis. Groq: https://api.groq.com/openai/v1
AI_BASE_URL=
AI_API_KEY=your_api_key_here
AI_MODEL=llama-3.3-70b-versatile

# Vision AI (opsional) — model vision untuk analisis foto, mis. openai/gpt-oss-20b
AI_VISION_MODEL=

# Cuaca (opsional) — API key gratis dari openweathermap.org
WEATHER_API_KEY=

# Downloader YouTube/Instagram (opsional)
YT_DL_API_URL=
IG_DL_API_URL=
